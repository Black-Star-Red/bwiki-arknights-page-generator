{
  "cookies": "",
  "schema": {
    "character_table": {
      "currentCharId": { "kind": "var", "type": "string", "required": true },
      "charIdS": { "path": "charIdS", "type": "list[string]", "required": true },
      "talent_phase": {
        "path": "talent_phase",
        "type": "string",
        "enum": ["PHASE_0", "PHASE_1", "PHASE_2"]
      }
    }
  },
  "data_source_roots": {
    "Kengxxiao/ArknightsGameData": "../ArknightsData/Kengxxiao.ArknightsGameData",
    "yuanyan3060/ArknightsGameResource": "../ArknightsData/yuanyan3060.ArknightsGameResource",
    "ArknightsAssets/ArknightsGamedata": "../ArknightsData/ArknightsAssets.ArknightsGamedata"
  },
  "$include": [
    "data_sources/Kengxxiao.ArknightsGameData.json",
    "data_sources/yuanyan3060.ArknightsGameResource.json",
    "data_sources/ArknightsAssets.ArknightsGamedata.json"
  ],
  "database": {
    "enabled": false,
    "url":"",
    "write_after_fallback": true,
    "supplementary": {
      "prefer_db": true,
      "fallback_bilibili": true,
      "skip_bilibili_discover_if_db_complete": true,
      "required_fields": ["获取途径", "实装日期"]
    },
    "activity": {
      "table": "activities",
      "sync_from_data_source": true
    }
  },
  "hypergryph": {
    "bulletin_list_url": "https://ak-webview.hypergryph.com/api/game/bulletinList",
    "bulletin_detail_url": "https://ak-webview.hypergryph.com/api/game/bulletin/{cid}",
    "dynamic_compile_url": "https://ak.hypergryph.com/archive/dynamicCompile",
    "bulletin_target": "Android"
  }
}